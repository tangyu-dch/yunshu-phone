# Binaries and compiled outputs
build/bin/
*.exe
*.dll
*.so
*.dylib
*.app
*.dmg
*.pkg

# Go ignores
*.test
*.out
vendor/

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Wails auto-generated bindings (regenerated on build)
# Note: You can optionally track wailsjs/go/ if you want frontend typing without having Wails installed,
# but usually it's ignored.
frontend/wailsjs/go/
frontend/wailsjs/runtime/

# IDE & OS Specific
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# Environment variables
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Logs and debugs
*.log
logs/

# Coverage
coverage/
.nyc_output/

# Certificates (never commit secrets)
build/certs/*.key
build/certs/*.pfx
build/certs/*.crt
build/certs/*.pem

# Documentation screenshots
# docs/login.png
# docs/init.png
# docs/dialpad.png
# docs/records.png
